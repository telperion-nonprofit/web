{
  "name": "telperion-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check:head": "node scripts/check-head-integrity.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "npm run test:unit && playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "tsx --test 'tests/unit/**/*.test.ts'",
    "test:e2e": "playwright test",
    "typecheck": "astro check",
    "tolgee:extract": "tolgee extract",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.10",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@iconify-json/mdi": "^1.2.3",
    "@sentry/astro": "^10.74.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tolgee/web": "^7.2.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.3.2",
    "astro-icon": "^1.2.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tolgee/cli": "^2.20.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^2.1.1",
    "globals": "^17.12.0",
    "parse5": "^8.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  }
}

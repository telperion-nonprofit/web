---
import Layout from "../layouts/Layout.astro";
import SectionBadge from "../components/SectionBadge.astro";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  {
    name: "Instagram CZ",
    description: t("social.instagram_cz_description"),
    href: "https://www.instagram.com/telperion.cz/",
    icon: "mdi:instagram",
    primary: true,
  },
  {
    name: "Instagram EN",
    description: t("social.instagram_en_description"),
    href: "https://www.instagram.com/telperion.en/",
    icon: "mdi:instagram",
  },
  {
    name: "LinkedIn",
    description: t("social.linkedin_description"),
    href: "https://www.linkedin.com/company/telperion-nonprofit/",
    icon: "mdi:linkedin",
  },
  {
    name: "Facebook",
    description: t("social.facebook_description"),
    href: "https://www.facebook.com/telperion.cz",
    icon: "mdi:facebook",
  },
  {
    name: "YouTube",
    description: t("social.youtube_description"),
    href: "https://www.youtube.com/@telperion-cz/",
    icon: "mdi:youtube",
  },
  {
    name: "GitHub",
    description: t("social.github_description"),
    href: "https://github.com/annazez/telperion-web",
    icon: "mdi:github",
  },
];
---

<Layout title={t("social.page_title")}>
  <section class="pt-12 pb-8 md:pt-16 md:pb-10 text-center px-4">
    <div class="container mx-auto max-w-4xl">
      <SectionBadge>{t("social.badge")}</SectionBadge>
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-brand-green mb-6">
        {t("social.title_main")}{" "}
        <span class="italic">{t("social.title_highlight")}</span>
      </h1>
      <p class="text-lg md:text-xl text-dark-green/80 leading-relaxed max-w-2xl mx-auto font-medium">
        {t("social.description")}
      </p>
    </div>
  </section>

  <section class="pb-16 md:pb-24">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
        {links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="glass-card rounded-3xl p-6 flex flex-col min-h-48 transition-transform duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-green/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-green"
            aria-label={`${link.name} - ${t("social.external_link")}`}
          >
            <div class="flex items-start justify-between gap-4 mb-6">
              <div class="w-12 h-12 rounded-2xl bg-brand-green/10 border border-brand-green/20 flex items-center justify-center text-brand-green">
                <Icon name={link.icon} class="w-6 h-6" />
              </div>
              {link.primary && (
                <span class="rounded-full bg-brand-green/10 px-3 py-1 text-xs font-bold text-brand-green">
                  {t("social.primary_label")}
                </span>
              )}
            </div>
            <h2 class="text-2xl font-serif font-bold text-brand-green mb-3">
              {link.name}
            </h2>
            <p class="text-sm text-dark-green/75 font-medium leading-relaxed">
              {link.description}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

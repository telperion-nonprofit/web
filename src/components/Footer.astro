---
import { getLangFromUrl, translatePath, useTranslations } from "../i18n";

const currentYear = new Date().getFullYear();
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="w-full flex justify-center pb-6 px-4">
  <div
    class="glass-card shadow-[0_8px_30px_rgb(0,0,0,0.06)] rounded-[2rem] px-6 md:px-8 py-4 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4"
  >
    <p
      class="text-sm text-dark-green font-medium tracking-wide text-center md:text-left"
    >
      &copy; {currentYear} Telperion z.s.
    </p>
    <span class="hidden sm:block h-4 w-px bg-dark-green/20" aria-hidden="true"
    ></span>
    <a
      href={translatePath("/ochrana-osobnich-udaju", lang)}
      class="inline-flex items-center min-h-6 px-1 text-sm text-dark-green font-bold hover:text-brand-green transition-colors duration-200"
    >
      {t("footer.privacy")}
    </a>
  </div>
</footer>

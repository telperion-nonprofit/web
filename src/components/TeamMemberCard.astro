---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";
import type { TeamMember } from "../data/team";
import { getLangFromUrl, useTranslations } from "../i18n";

interface Props extends HTMLAttributes<"div"> {
  member: TeamMember;
}

const { member, class: className, ...attrs } = Astro.props;

const t = useTranslations(getLangFromUrl(Astro.url));
const role = t(member.roleKey);
const [emailUser, emailDomain] = member.email.split("@");
---

<div
  class:list={[
    "glass-card rounded-3xl p-6 sm:p-8 transform-gpu will-change-transform flex flex-col transition-transform duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-green/10",
    className,
  ]}
  data-testid="team-member"
  {...attrs}
>
  <div class="w-24 h-24 rounded-full bg-brand-green/10 flex items-center justify-center text-brand-green mb-6 mx-auto overflow-hidden border-2 border-brand-green/20">
    {member.image ? (
      <Image
        src={member.image}
        alt={member.name}
        class="w-full h-full object-cover"
        width={96}
        height={96}
        densities={[1, 2]}
        quality={60}
      />
    ) : (
      <svg
        viewBox="0 0 96 96"
        class="w-full h-full text-brand-green/30"
        fill="currentColor"
        aria-hidden="true"
        data-testid="avatar-placeholder"
      >
        <circle cx="48" cy="37" r="16" />
        <path d="M48 59c-18.5 0-33 11.5-33 27v10h66V86c0-15.5-14.5-27-33-27z" />
      </svg>
    )}
  </div>

  <div class="text-center mb-4">
    <h3 class="text-2xl font-serif font-bold text-brand-green mb-1">
      {member.name}
    </h3>
    {role && (
      <p class="text-sm font-bold text-dark-green/60 uppercase tracking-wider">
        {role}
      </p>
    )}
  </div>

  <div class="flex flex-col gap-2 mt-auto">
    <a
      href={`mailto:${member.email}`}
      class="flex items-center gap-3 text-sm text-dark-green font-medium hover:text-brand-green transition-colors p-2 rounded-xl hover:bg-white/40"
    >
      <Icon
        name="mdi:email-outline"
        class="w-5 h-5 text-brand-green flex-shrink-0"
      />
      {/* Long addresses wrap after the @ instead of being truncated. */}
      <span class="min-w-0 wrap-anywhere">
        {emailUser}@<wbr />
        {emailDomain}
      </span>
    </a>
    {member.phone && (
      <a
        href={`tel:${member.phone.replace(/\s+/g, "")}`}
        class="flex items-center gap-3 text-sm text-dark-green font-medium hover:text-brand-green transition-colors p-2 rounded-xl hover:bg-white/40"
      >
        <Icon
          name="mdi:phone-outline"
          class="w-5 h-5 text-brand-green flex-shrink-0"
        />
        <span>{member.phone}</span>
      </a>
    )}
  </div>
</div>

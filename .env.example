# Sentry needs no variables to report errors: the DSN is in
# sentry.client.config.js and it runs only in Vercel builds. To try it from a
# local build, run `SENTRY_ENABLED=true npm run build` (astro.config.mjs reads
# process.env, not this file).

# Keep at 0 unless you intentionally want performance tracing.
PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Build-time only, used for the source map upload. The Sentry integration on
# the Vercel project sets it. Never expose this as PUBLIC_.
SENTRY_AUTH_TOKEN=
